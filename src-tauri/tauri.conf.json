{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PomiTranslate",
  "version": "0.1.0",
  "identifier": "app.pomitranslate.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PomiTranslate",
        "width": 1180,
        "height": 800,
        "minWidth": 840,
        "minHeight": 620,
        "backgroundColor": "#fafafa",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/kim0040/PomiTranslate/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "publisher": "PomiTranslate contributors",
    "copyright": "Copyright (c) 2026 PomiTranslate contributors. MIT License.",
    "category": "Utility",
    "homepage": "https://github.com/kim0040/PomiTranslate",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Translate Minecraft worlds with an AI provider you choose.",
    "longDescription": "PomiTranslate scans a Minecraft Java world, translates the text it finds (books, signs, item names, command blocks and more) with the AI provider you choose, and keeps a backup so every change can be restored.",
    "resources": {
      "../build/sidecar/dist/pomi-sidecar/": "pomi-sidecar/"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English",
          "Japanese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
