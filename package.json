{
  "name": "pomitranslate-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test:frontend": "vitest run tests/frontend",
    "build": "pnpm check && vite build",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "licenses": "node scripts/generate-licenses.mjs",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "desktop:dev": "pnpm sidecar:build && tauri dev",
    "desktop:build": "pnpm sidecar:build:clean && tauri build",
    "tauri": "tauri",
    "test:browser": "playwright test",
    "verify:plan": "node scripts/verify.mjs check frontend browser-smoke",
    "verify:ui": "node scripts/verify.mjs check frontend browser-smoke --run",
    "verify:final": "node scripts/verify.mjs check frontend python-final rust-final browser-final --run",
    "sidecar:build:clean": "node scripts/build-sidecar.mjs --clean",
    "desktop:dev:ui": "tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "@tauri-apps/plugin-notification": "2.5.1",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "26.6.3",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "^5.0.2"
  }
}
